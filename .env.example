# Cockpit — variables d'environnement du VPS.
# Copier en .env dans /srv/pilotage/ et compléter. Ce fichier n'est jamais commité.

# --- Obligatoires ---------------------------------------------------------
CK_DB_PASSWORD=
CK_JWT_SECRET=

# --- Optionnelles ---------------------------------------------------------
# Domaine servi par Traefik. Front et API sont derrière le même nom : nginx
# sert les pages et proxifie /api/ vers l'API sur le réseau interne.
CK_HOST=pilotage.alex-worksmart.com

# Mot de passe du compte « admin » créé au premier démarrage.
# À changer depuis l'écran Réglages une fois connecté.
# Mots de passe des comptes declares dans api/db.js. Sans la variable, le
# compte n'est pas cree. Il n'y a plus de mot de passe par defaut : l'ancien
# CK_DEFAULT_PASSWORD valait « cockpit » et etait ecrit dans les journaux.
CK_PASS_ALEXANDRE=
CK_PASS_NORBERT=

# Mois d'historique conservés (8 semaines + 12 mois tiennent dans 14).
CK_RETENTION_MONTHS=14

CK_DB_NAME=cockpit
CK_DB_USER=cockpit

# Origines autorisées, séparées par des virgules. À laisser vide dans ce
# montage : le front et l'API partagent l'origine, et l'API n'est joignable
# que depuis le réseau Docker interne. Ne sert que si le front est un jour
# déporté sur un autre domaine (Cloudflare Pages, par exemple).
CK_CORS_ORIGIN=

# --- Passerelle DepanTime -------------------------------------------------
# Fournit l'effectif du jour, les jours travaillés et les heures payées.
# L'appel est interne au VPS (réseau Docker) : le mot de passe ne sort pas.
# Utiliser un compte DepanTime dédié, en lecture — le Cockpit n'écrit jamais.
CK_DEPANTIME_URL=http://depantime-api:3000
CK_DEPANTIME_USER=
CK_DEPANTIME_PASSWORD=

# --- API PowerPanne (quand elle sera ouverte) -----------------------------
# CK_POWERPANNE_URL=https://api.powerpanne.example/v1/interventions
# CK_POWERPANNE_TOKEN=
